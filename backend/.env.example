# Port the API listens on
PORT=3000

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgres://internhub:internhub@localhost:5432/internhub

# Origin(s) allowed by CORS - the address the frontend is served from.
# Comma-separate several (Live Server may use either localhost or 127.0.0.1).
FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
